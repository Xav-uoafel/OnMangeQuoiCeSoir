# Public URL (hostname only, without https://)
APP_HOST=app.example.com
APP_PROTOCOL=https
# APP_PORT=443
SECRET_KEY_BASE=

# PostgreSQL. DATABASE_URL replaces the four DATABASE_* variables below.
DATABASE_URL=postgresql://user:password@database:5432/onmangequoi_production
# DATABASE_HOST=database
# DATABASE_NAME=onmangequoi_production
# DATABASE_USERNAME=onmangequoi
# DATABASE_PASSWORD=change-me
RAILS_MAX_THREADS=5

# Uploads: use amazon for S3-compatible object storage, or local with a persistent volume.
ACTIVE_STORAGE_SERVICE=amazon
S3_BUCKET=onmangequoi-production
S3_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.example.com
# S3_FORCE_PATH_STYLE=true

# Transactional email used by Devise.
MAILER_FROM=no-reply@example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_DOMAIN=example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPEN_TIMEOUT=5
SMTP_READ_TIMEOUT=5

# Without SMTP_ADDRESS, development emails are captured at /dev/emails.

# Recipe generation falls back to the local catalogue when this key is absent.
# Photo scans require the key; the models can be overridden independently.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_DETAIL=high

RAILS_LOG_LEVEL=info
JOB_CONCURRENCY=1
