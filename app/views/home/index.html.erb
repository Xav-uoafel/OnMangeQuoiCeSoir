<div class="space-y-10">
  <section class="da-shell">
    <div class="relative grid gap-10 px-5 py-8 sm:px-8 sm:py-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:px-12 lg:py-16">
      <div class="relative z-10">
        <div class="mb-6 flex flex-wrap gap-2 sm:mb-8">
          <span class="da-chip">Menus adaptatifs</span>
          <span class="da-chip">Stock utile</span>
          <span class="da-chip">Courses nettes</span>
        </div>

        <p class="page-kicker">Le dîner sort du brouillard</p>
        <h1 class="da-hero-title mt-4 text-slate-950">
          <span>On Mange</span>
          <span>Quoi Ce</span>
          <span><span class="da-hero-script">Soir ?</span></span>
        </h1>

        <p class="mt-7 max-w-xl text-lg font-medium leading-8 text-slate-700">
          Générez des plans de repas personnalisés, exploitez votre stock et sortez une liste de courses propre.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <% if user_signed_in? %>
            <%= link_to "Composer ma semaine", new_plan_path, class: "btn-primary" %>
            <%= link_to "Scanner mon stock", new_pantry_scan_path, class: "btn-secondary" %>
          <% else %>
            <%= link_to "Commencer", new_user_registration_path, class: "btn-primary" %>
            <%= link_to "Se connecter", new_user_session_path, class: "btn-secondary" %>
          <% end %>
        </div>
      </div>

      <div class="relative z-10">
        <div class="da-ticket p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4 pb-8">
            <div>
              <p class="text-xs font-black uppercase tracking-[0.22em] text-slate-500">Ticket semaine</p>
              <p class="mt-2 text-2xl font-black text-slate-950">Plan du soir</p>
            </div>
            <div class="rounded-full bg-[#ffd166] px-3 py-1 text-xs font-black text-slate-950">7 jours</div>
          </div>

          <div class="space-y-3 pt-2">
            <div class="rounded-2xl bg-white/70 p-4">
              <div class="flex items-center justify-between">
                <span class="font-black">Lundi</span>
                <span class="text-sm font-bold text-[#627a31]">15 min</span>
              </div>
              <p class="mt-1 text-sm text-slate-600">Pâtes citron, parmesan, roquette</p>
            </div>
            <div class="rounded-2xl bg-[#101119] p-4 text-white">
              <div class="flex items-center justify-between">
                <span class="font-black">Mardi</span>
                <span class="text-sm font-bold text-[#ffd166]">placard</span>
              </div>
              <p class="mt-1 text-sm text-white/70">Riz sauté, légumes, œuf mollet</p>
            </div>
            <div class="rounded-2xl bg-white/70 p-4">
              <div class="flex items-center justify-between">
                <span class="font-black">Mercredi</span>
                <span class="text-sm font-bold text-[#e84f35]">à acheter</span>
              </div>
              <p class="mt-1 text-sm text-slate-600">Cabillaud, fenouil, pommes vapeur</p>
            </div>
          </div>

          <div class="mt-5 grid grid-cols-3 gap-2 text-center text-xs font-black">
            <div class="rounded-2xl bg-white/60 p-3">
              <p class="text-2xl">12</p>
              <p class="text-slate-500">repas</p>
            </div>
            <div class="rounded-2xl bg-white/60 p-3">
              <p class="text-2xl">8</p>
              <p class="text-slate-500">stock</p>
            </div>
            <div class="rounded-2xl bg-white/60 p-3">
              <p class="text-2xl">19</p>
              <p class="text-slate-500">courses</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p class="page-kicker">Inspiration</p>
        <h2 class="da-section-title mt-1 text-4xl font-black text-slate-950 sm:text-5xl">
          Dernières recettes
        </h2>
      </div>
      <%= link_to "Tout voir", recipes_path, class: "hidden text-sm font-black text-emerald-800 hover:text-emerald-950 sm:inline" %>
    </div>

    <% if @recipes.any? %>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% @recipes.each do |recipe| %>
          <%= link_to recipe_path(recipe), class: "group rounded-3xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--omq-tomato)]", aria: { label: "Voir la recette #{recipe.title}" } do %>
            <article class="da-recipe-card h-full p-5 sm:p-6">
              <div class="mb-5 h-2 w-16 rounded-full bg-[#e84f35]" aria-hidden="true"></div>
              <h3 class="da-section-title text-2xl font-black leading-tight text-slate-950">
                <%= recipe.title %>
              </h3>

              <div class="mt-3 flex items-center gap-2" aria-label="Note moyenne : <%= recipe.average_rating %> sur 5">
                <%= rating_stars(recipe.average_rating) %>
                <span class="text-sm font-bold text-slate-500">
                  (<%= pluralize(recipe.total_reviews, 'avis') %>)
                </span>
              </div>

              <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-600">
                <%= recipe.description %>
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                <span class="da-chip"><%= recipe.difficulty %></span>
                <span class="da-chip"><%= recipe.preparation_time + recipe.cooking_time %> min</span>
              </div>
            </article>
          <% end %>
        <% end %>
      </div>
      <%= link_to "Voir toutes les recettes", recipes_path, class: "btn-secondary mt-4 w-full sm:hidden" %>
    <% else %>
      <div class="empty-state">
        <p class="text-xl font-black">Les premières recettes arrivent bientôt</p>
        <p class="mt-2 text-sm text-slate-600">Créez un compte pour composer votre propre semaine.</p>
      </div>
    <% end %>
  </section>
</div>
