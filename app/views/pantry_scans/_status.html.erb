<% if scan.analysis_stale? %>
  <div class="rounded-3xl border border-amber-300 bg-amber-50 p-6 text-center text-amber-950 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100">
    <h3 class="text-lg font-black">L’analyse prend trop de temps</h3>
    <p class="mt-2 text-sm"><%= scan.analysis_error_message %></p>
    <%= button_to "Relancer l’analyse", retry_analysis_pantry_scan_path(scan),
        method: :post,
        class: "btn-primary mt-4",
        form: { class: "inline-block" },
        data: { turbo_submits_with: "Relance…" } %>
  </div>
<% elsif scan.processing? %>
  <div class="app-card p-6 text-center">
    <div class="mb-4 inline-block h-9 w-9 animate-spin rounded-full border-4 border-emerald-600 border-t-transparent"></div>
    <h3 class="text-lg font-black text-slate-950 dark:text-white">Analyse en cours...</h3>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">L’IA examine vos photos. Vous pouvez quitter cette page, le traitement continue en arrière-plan.</p>
  </div>
<% elsif scan.pending_review? %>
  <div class="rounded-3xl border border-amber-200 bg-amber-50 p-4 dark:border-amber-900 dark:bg-amber-950/30">
    <p class="font-bold text-amber-900 dark:text-amber-200"><%= pluralize(scan.items_detected, "ingrédient détecté", "ingrédients détectés") %>. Vérifiez-les avant l’ajout au stock.</p>
  </div>
<% elsif scan.failed? %>
  <div class="rounded-3xl border border-red-200 bg-red-50 p-6 text-center dark:border-red-900 dark:bg-red-950/40">
    <h3 class="text-lg font-black text-red-900 dark:text-red-100">Erreur d'analyse</h3>
    <p class="mt-2 text-sm text-red-800 dark:text-red-200"><%= scan.analysis_error_message %></p>
    <%= button_to "Relancer avec ces photos", retry_analysis_pantry_scan_path(scan),
        method: :post,
        class: "btn-primary mt-4",
        form: { class: "inline-block" },
        data: { turbo_submits_with: "Relance…" } %>
  </div>
<% elsif scan.completed? %>
  <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-4 dark:border-emerald-900 dark:bg-emerald-950/30">
    <p class="font-bold text-emerald-800 dark:text-emerald-200"><%= pluralize(scan.items_detected, "ingrédient ajouté", "ingrédients ajoutés") %> à votre stock.</p>
  </div>
<% elsif scan.discarded? %>
  <div class="app-card-muted p-4">
    <p class="font-bold text-slate-700 dark:text-slate-300">Scan ignoré. Aucun ingrédient ajouté au stock.</p>
  </div>
<% end %>
