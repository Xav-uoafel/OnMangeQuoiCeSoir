<% if scan.processing? %>
  <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 rounded-lg p-6 text-center">
    <div class="animate-spin inline-block w-8 h-8 border-4 border-green-600 border-t-transparent rounded-full mb-4"></div>
    <h3 class="text-lg font-semibold text-green-900 dark:text-green-400">Analyse en cours...</h3>
    <p class="text-green-700 dark:text-green-400 mt-2">L'IA examine vos photos pour identifier les ingredients.</p>
  </div>
<% elsif scan.status == 'failed' %>
  <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700 rounded-lg p-6 text-center">
    <h3 class="text-lg font-semibold text-red-900 dark:text-red-400">Erreur d'analyse</h3>
    <p class="text-red-700 dark:text-red-400 mt-2">Un probleme est survenu lors de l'analyse des photos.</p>
    <%= link_to "Reessayer", new_pantry_scan_path,
        class: "mt-4 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700" %>
  </div>
<% elsif scan.completed? %>
  <div class="bg-green-50 dark:bg-green-900/30 border border-green-200 dark:border-green-700 rounded-lg p-4">
    <p class="text-green-800 dark:text-green-400 font-medium"><%= scan.items_detected %> ingredients detectes et ajoutes a votre stock.</p>
  </div>
<% end %>
