<div class="max-w-2xl mx-auto py-8 px-4">
  <h1 class="text-3xl font-bold mb-8">Scanner le frigo</h1>
  <p class="text-gray-600 dark:text-gray-400 mb-6">Prenez 1 a 5 photos de votre frigo, placard ou plan de travail. L'IA identifiera les ingredients.</p>

  <%= form_with(model: @pantry_scan, url: pantry_scans_path, multipart: true, class: "space-y-6") do |f| %>
    <div class="bg-white dark:bg-gray-800 shadow dark:shadow-gray-900/50 rounded-lg p-6">
      <div>
        <%= f.label :label, "Nom du scan (optionnel)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.text_field :label, placeholder: "Ex: Frigo, Placard cuisine",
            class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="mt-4">
        <%= f.label :photos, "Photos", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.file_field :photos, multiple: true, accept: "image/*",
            class: "mt-1 block w-full text-sm text-gray-500 dark:text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100" %>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Formats acceptes : JPG, PNG. Maximum 5 photos.</p>
      </div>
    </div>

    <div class="flex justify-between">
      <%= link_to "Retour au stock", pantry_items_path,
          class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700" %>
      <%= f.submit "Lancer le scan", class: "inline-flex items-center px-6 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700" %>
    </div>
  <% end %>
</div>
