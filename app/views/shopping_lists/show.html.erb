<%= turbo_stream_from "shopping_list_#{@shopping_list.id}" %>

<div class="mx-auto max-w-3xl space-y-6">
  <div class="app-card p-5 sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="page-kicker">En magasin</p>
        <h1 class="page-title mt-2">Liste de courses</h1>
        <p class="page-subtitle">
        Plan du <%= l @plan.start_date, format: :short %> au <%= l @plan.end_date, format: :short %>
      </p>
    </div>
      <div class="w-full rounded-3xl bg-slate-950 px-5 py-4 text-white sm:w-48 dark:bg-emerald-400 dark:text-slate-950" aria-label="Progression de la liste de courses">
        <div class="flex items-end justify-between gap-3">
          <span class="text-sm font-bold opacity-80">Progression</span>
          <span class="text-3xl font-black"><%= @shopping_list.progress_percentage %>%</span>
        </div>
        <progress class="shopping-progress" value="<%= @shopping_list.progress_percentage %>" max="100"><%= @shopping_list.progress_percentage %>%</progress>
      </div>
    </div>
  </div>

  <%= render "shopping_lists/content",
      plan: @plan,
      shopping_list: @shopping_list,
      items_by_category: @items_by_category %>

  <div class="mobile-sticky-actions">
    <div class="mx-auto grid max-w-3xl grid-cols-2 gap-3">
    <%= link_to "Retour au plan", @plan,
        class: "btn-secondary w-full" %>
    <%= link_to "Voir mon stock", pantry_items_path,
        class: "btn-primary w-full" %>
    </div>
  </div>
</div>
