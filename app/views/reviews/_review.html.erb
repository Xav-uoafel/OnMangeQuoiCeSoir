<article class="app-card p-5 sm:p-6" id="<%= dom_id(review) %>">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <p class="break-all text-sm font-black text-slate-900 dark:text-slate-100"><%= review.user.email %></p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <%= rating_stars(review.rating) %>
        <time class="text-xs font-bold text-slate-500 dark:text-slate-400" datetime="<%= review.created_at.iso8601 %>"><%= l(review.created_at, format: :long) %></time>
      </div>
    </div>

    <% if review.user == current_user %>
      <div class="flex shrink-0 gap-2">
        <%= link_to "Modifier", edit_recipe_review_path(review.recipe, review), class: "btn-secondary btn-compact" %>
        <%= button_to "Supprimer", recipe_review_path(review.recipe, review), method: :delete,
            class: "btn-danger btn-compact",
            data: { turbo_confirm: "Supprimer définitivement cet avis ?" } %>
      </div>
    <% end %>
  </div>

  <p class="mt-4 whitespace-pre-line text-sm leading-6 text-slate-700 dark:text-slate-300"><%= review.comment %></p>
</article>
