<%= form_with(model: [recipe, review], class: "space-y-5") do |f| %>
  <% if review.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-red-900 dark:border-red-900 dark:bg-red-950/40 dark:text-red-100" role="alert">
      <h3 class="text-sm font-black"><%= pluralize(review.errors.count, "erreur") %> à corriger</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% review.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <fieldset>
    <legend class="form-label"><%= t('reviews.form.rating_label') %></legend>
    <div class="mt-2 flex items-center gap-1" data-controller="rating" data-rating="<%= review.rating %>">
      <% 5.times do |i| %>
        <label class="relative flex min-h-11 min-w-11 cursor-pointer items-center justify-center rounded-xl">
          <%= f.radio_button :rating, i + 1,
              class: "peer sr-only",
              required: true,
              data: {
                rating_target: "input",
                action: "change->rating#select",
                index: i
              } %>
          <span class="sr-only"><%= i + 1 %> <%= i.zero? ? "étoile" : "étoiles" %></span>
          <svg
            data-rating-target="star"
            data-action="mouseover->rating#highlight mouseout->rating#reset"
            data-index="<%= i %>"
            aria-hidden="true"
            class="h-8 w-8 text-gray-300 transition-colors duration-150 peer-focus-visible:rounded-lg peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-[var(--omq-tomato)] dark:text-gray-600"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor">
            <path fill-rule="evenodd"
                  d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z"
                  clip-rule="evenodd" />
          </svg>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div>
    <%= f.label :comment, t('reviews.form.comment_label'), class: "form-label" %>
    <%= f.text_area :comment,
        placeholder: t('reviews.form.placeholder'),
        class: "form-input mt-2",
        rows: 4,
        required: true,
        minlength: 10,
        maxlength: 500,
        aria: { describedby: "review-comment-help" } %>
    <p id="review-comment-help" class="form-help">Entre 10 et 500 caractères.</p>
  </div>

  <%= f.submit t('reviews.form.submit'), class: "btn-primary w-full cursor-pointer sm:w-auto", data: { turbo_submits_with: "Publication…" } %>
<% end %>
