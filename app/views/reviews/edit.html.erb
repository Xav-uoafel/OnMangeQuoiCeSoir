<div class="mx-auto max-w-2xl space-y-6">
  <div class="app-card p-5 sm:p-8">
    <p class="page-kicker">Avis</p>
    <h1 class="page-title mt-2">Modifier votre avis</h1>
    <p class="page-subtitle"><%= @recipe.title %></p>
  </div>

  <div class="app-card p-5 sm:p-8">
    <%= render "form", recipe: @recipe, review: @review %>
  </div>

  <%= link_to "Retour à la recette", recipe_path(@recipe), class: "btn-secondary w-full sm:w-auto" %>
</div>
