<div class="mx-auto max-w-5xl space-y-6">
  <div class="app-card p-5 sm:p-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="page-kicker">Frigo et placards</p>
        <h1 class="page-title mt-2">Mon stock</h1>
        <p class="page-subtitle">Gardez un stock propre : moins de doublons, meilleures listes de courses.</p>
      </div>
      <div class="hidden gap-3 sm:flex">
      <% if @duplicate_count.positive? %>
        <%= button_to "Fusionner #{@duplicate_count} doublon(s)", merge_duplicates_pantry_items_path,
            method: :post,
            class: "btn-secondary",
            data: { turbo_confirm: "Fusionner les ingrédients qui semblent identiques ?" } %>
      <% end %>
      <%= link_to "Scanner le frigo", new_pantry_scan_path,
          class: "btn-primary" %>
      </div>
    </div>
  </div>

  <div class="app-card p-5 sm:p-6">
    <h2 class="text-lg font-black mb-4">Ajouter un ingrédient</h2>
    <%= form_with(model: PantryItem.new, url: pantry_items_path, class: "grid gap-4 sm:grid-cols-[1fr_12rem_9rem_auto] sm:items-end") do |f| %>
      <div>
        <%= f.label :name, "Ingrédient", class: "form-label" %>
        <%= f.text_field :name, placeholder: "Ex. tomates", required: true, autocomplete: "off",
            class: "form-input mt-2" %>
      </div>
      <div>
        <%= f.label :category, "Catégorie", class: "form-label" %>
        <%= f.select :category,
            options_for_select(PantryItem::CATEGORIES.map { |c| [ingredient_category_label(c), c] }),
            { include_blank: "Catégorie" },
            class: "form-input mt-2" %>
      </div>
      <div>
        <%= f.label :quantity_text, "Quantité", class: "form-label" %>
        <%= f.text_field :quantity_text, placeholder: "Ex. 500 g", autocomplete: "off",
            class: "form-input mt-2" %>
      </div>
      <%= f.submit "Ajouter", class: "btn-primary w-full sm:w-auto" %>
    <% end %>
  </div>

  <% if @pantry_items.any? %>
    <div class="grid gap-4">
      <% @items_by_category.each do |category, items| %>
        <div class="app-card overflow-hidden">
          <div class="flex items-center justify-between border-b border-slate-100 bg-white/60 px-4 py-3 dark:border-slate-800 dark:bg-slate-900/60">
            <h3 class="font-black text-slate-800 dark:text-slate-100"><%= ingredient_category_label(category || "autre") %></h3>
            <span class="pill"><%= items.size %></span>
          </div>
        <ul class="divide-y divide-slate-100 dark:divide-slate-800">
          <% items.each do |item| %>
            <li class="px-4 py-3">
              <%= form_with(model: item, url: pantry_item_path(item), method: :patch, class: "grid gap-3 md:grid-cols-[1fr_12rem_9rem_auto] md:items-end", aria: { label: "Modifier #{item.name}" }) do |f| %>
                <div>
                  <%= f.label :name, "Nom", for: "pantry_item_#{item.id}_name", class: "form-label md:sr-only" %>
                  <%= f.text_field :name,
                      id: "pantry_item_#{item.id}_name",
                      required: true,
                      autocomplete: "off",
                      class: "form-input mt-2 text-sm md:mt-0" %>
                  <% if item.source == 'photo_scan' %>
                    <span class="mt-2 inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-bold text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-200">scan</span>
                  <% end %>
                </div>
                <div>
                  <%= f.label :category, "Catégorie", for: "pantry_item_#{item.id}_category", class: "form-label md:sr-only" %>
                  <%= f.select :category,
                      options_for_select(PantryItem::CATEGORIES.map { |c| [ingredient_category_label(c), c] }, item.category),
                      { include_blank: "Catégorie" },
                      id: "pantry_item_#{item.id}_category",
                      class: "form-input mt-2 text-sm md:mt-0" %>
                </div>
                <div>
                  <%= f.label :quantity_text, "Quantité", for: "pantry_item_#{item.id}_quantity", class: "form-label md:sr-only" %>
                  <%= f.text_field :quantity_text,
                      id: "pantry_item_#{item.id}_quantity",
                      placeholder: "Ex. 500 g",
                      autocomplete: "off",
                      class: "form-input mt-2 text-sm md:mt-0" %>
                </div>
                <%= f.submit "Enregistrer", class: "btn-secondary w-full md:w-auto" %>
              <% end %>

              <div class="mt-2 flex justify-end">
                <%= button_to pantry_item_path(item), method: :delete,
                    class: "min-h-11 px-3 text-sm font-bold text-red-600 hover:text-red-800 dark:text-red-300",
                    data: { turbo_confirm: "Retirer #{item.name} du stock ?" } do %>
                  Retirer
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p class="text-2xl font-black">Votre stock est vide</p>
      <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-600 dark:text-slate-300">Ajoutez un ingrédient ci-dessus ou photographiez votre frigo pour démarrer plus vite.</p>
      <%= link_to "Scanner mon frigo", new_pantry_scan_path, class: "btn-primary mt-6 w-full sm:w-auto" %>
    </div>
  <% end %>

  <div class="mobile-sticky-actions">
    <div class="grid grid-cols-2 gap-3">
      <% if @duplicate_count.positive? %>
        <%= button_to "Fusionner", merge_duplicates_pantry_items_path, method: :post, class: "btn-secondary w-full", data: { turbo_confirm: "Fusionner les ingrédients qui semblent identiques ?" } %>
      <% else %>
        <%= link_to "Nouveau plan", new_plan_path, class: "btn-secondary w-full" %>
      <% end %>
      <%= link_to "Scanner", new_pantry_scan_path, class: "btn-primary w-full" %>
    </div>
  </div>
</div>
