<div class="auth-page">
  <div class="auth-stack">
    <div class="app-card p-6 text-center sm:p-8">
      <p class="page-kicker">Première semaine</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950 dark:text-white">Créer un compte</h1>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">Planifiez vos repas et construisez votre stock au fil des semaines.</p>
    </div>

    <div class="app-card p-5 sm:p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Adresse email", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "vous@exemple.com", autocapitalize: "none", spellcheck: false,
              class: "form-input mt-2" %>
        </div>

        <div>
          <%= f.label :password, "Mot de passe", class: "form-label" %>
          <% if @minimum_password_length %>
            <p id="password-minimum" class="form-help"><%= @minimum_password_length %> caractères minimum</p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", required: true, placeholder: "Votre mot de passe",
              aria: (@minimum_password_length ? { describedby: "password-minimum" } : {}),
              class: "form-input mt-2" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, placeholder: "Confirmez votre mot de passe",
              class: "form-input mt-2" %>
        </div>

        <div>
          <%= f.submit "Créer mon compte",
              class: "btn-primary w-full cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-sm text-slate-600 dark:text-slate-300">
          Déjà un compte ?
          <%= link_to "Connectez-vous", new_session_path(resource_name),
              class: "auth-link" %>
        </p>
      </div>
    </div>
  </div>
</div>
