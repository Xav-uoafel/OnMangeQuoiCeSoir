<div class="mt-6 space-y-2 text-center text-sm">
  <%- if controller_name != 'sessions' %>
    <div>
      <%= link_to "Se connecter", new_session_path(resource_name),
          class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-500" %>
    </div>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <div>
      <%= link_to "Creer un compte", new_registration_path(resource_name),
          class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-500" %>
    </div>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <div>
      <%= link_to "Mot de passe oublie ?", new_password_path(resource_name),
          class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-500" %>
    </div>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <div>
      <%= link_to "Renvoyer les instructions de confirmation", new_confirmation_path(resource_name),
          class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-500" %>
    </div>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <div>
      <%= link_to "Renvoyer les instructions de deverrouillage", new_unlock_path(resource_name),
          class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-500" %>
    </div>
  <% end %>
</div>
