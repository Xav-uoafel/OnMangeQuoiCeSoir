<div class="auth-page">
  <div class="auth-stack">
    <div class="app-card p-6 text-center sm:p-8">
      <p class="page-kicker">Accès au carnet</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950 dark:text-white">Mot de passe oublié ?</h1>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">Entrez votre email, nous vous enverrons un lien de réinitialisation.</p>
    </div>

    <div class="app-card p-5 sm:p-8">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Adresse email", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "vous@exemple.com", autocapitalize: "none", spellcheck: false,
              class: "form-input mt-2" %>
        </div>

        <div>
          <%= f.submit "Envoyer le lien",
              class: "btn-primary w-full cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <%= link_to "Retour à la connexion", new_session_path(resource_name),
            class: "auth-link text-sm" %>
      </div>
    </div>
  </div>
</div>
