<div class="auth-page">
  <div class="auth-stack">
    <div class="app-card p-6 text-center sm:p-8">
      <p class="page-kicker">Confirmation</p>
      <h1 class="mt-2 text-3xl font-black tracking-tight text-slate-950 dark:text-white">Renvoyer les instructions</h1>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">Recevez un nouveau lien pour confirmer votre compte.</p>
    </div>

    <div class="app-card p-5 sm:p-8">
      <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "Adresse email", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, autocapitalize: "none", spellcheck: false,
              value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
              class: "form-input mt-2" %>
        </div>

        <div>
          <%= f.submit "Renvoyer les instructions",
              class: "btn-primary w-full cursor-pointer" %>
        </div>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
