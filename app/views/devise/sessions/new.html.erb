<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-indigo-600 dark:text-indigo-400">OnMangeQuoiCeSoir?</h1>
      <p class="text-gray-500 dark:text-gray-400 mt-2">Connectez-vous pour acceder a vos plans de repas</p>
    </div>

    <div class="bg-white dark:bg-gray-800 shadow-xl dark:shadow-gray-900/50 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6">Connexion</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "space-y-5") do |f| %>
        <div>
          <%= f.label :email, "Adresse email", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "vous@exemple.com",
              class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 transition-colors" %>
        </div>

        <div>
          <%= f.label :password, "Mot de passe", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••",
              class: "block w-full rounded-lg border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 transition-colors" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center justify-between">
            <label class="flex items-center">
              <%= f.check_box :remember_me, class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 dark:border-gray-600 rounded" %>
              <span class="ml-2 text-sm text-gray-600 dark:text-gray-400">Se souvenir de moi</span>
            </label>
            <% if devise_mapping.recoverable? && controller_name != 'passwords' %>
              <%= link_to "Mot de passe oublie ?", new_password_path(resource_name),
                  class: "text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-500" %>
            <% end %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Se connecter",
              class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 dark:focus:ring-offset-gray-800 transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Pas encore de compte ?
          <%= link_to "Inscrivez-vous", new_registration_path(resource_name),
              class: "font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500" %>
        </p>
      </div>
    </div>
  </div>
</div>
