<article class="app-card flex h-full flex-col p-5 sm:p-6">
  <div class="flex items-start justify-between gap-3">
    <h3 class="da-section-title text-2xl font-black text-slate-950 dark:text-white"><%= recipe.title %></h3>
    <% if recipe.seasonal_score.positive? %>
      <span class="shrink-0 rounded-full bg-emerald-100 px-3 py-1 text-xs font-black text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-200"><%= recipe.seasonal_score %>% saison</span>
    <% end %>
  </div>

  <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600 dark:text-slate-300"><%= recipe.description %></p>

  <dl class="mt-5 grid grid-cols-2 gap-3 text-sm">
    <div><dt class="text-slate-500 dark:text-slate-400">Préparation</dt><dd class="font-black"><%= recipe.preparation_time %> min</dd></div>
    <div><dt class="text-slate-500 dark:text-slate-400">Cuisson</dt><dd class="font-black"><%= recipe.cooking_time %> min</dd></div>
    <div><dt class="text-slate-500 dark:text-slate-400">Difficulté</dt><dd class="font-black"><%= recipe.difficulty %></dd></div>
    <div><dt class="text-slate-500 dark:text-slate-400">Portions</dt><dd class="font-black"><%= recipe.servings %></dd></div>
  </dl>

  <%= link_to "Voir la recette", recipe_path(recipe), class: "btn-secondary mt-6 w-full" %>
</article>
