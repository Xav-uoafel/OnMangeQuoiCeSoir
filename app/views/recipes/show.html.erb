<div class="mx-auto max-w-5xl space-y-6">
  <article class="app-card overflow-hidden">
    <div class="relative p-5 sm:p-8">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-[#ffd166]/35 blur-2xl" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex flex-wrap items-center gap-2">
          <span class="page-kicker"><%= @recipe.difficulty %></span>
          <span class="pill"><%= @recipe.preparation_time + @recipe.cooking_time %> min</span>
          <% if @recipe.seasonal_score.positive? %>
            <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-black text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-200"><%= @recipe.seasonal_score %>% de saison</span>
          <% end %>
        </div>

        <h1 class="page-title mt-4 max-w-4xl"><%= @recipe.title %></h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600 dark:text-slate-300 sm:text-lg"><%= @recipe.description %></p>

        <div class="mt-6 flex flex-col gap-4 border-t border-slate-100 pt-5 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3" aria-label="Note moyenne : <%= @recipe.average_rating %> sur 5">
            <%= rating_stars(@recipe.average_rating) %>
            <span class="text-sm font-bold text-slate-500 dark:text-slate-400"><%= pluralize(@recipe.total_reviews, "avis") %></span>
          </div>

          <div class="flex flex-wrap gap-3">
            <%= link_to "Toutes les recettes", recipes_path, class: "btn-secondary btn-compact" %>
            <% if @recipe.user == current_user %>
              <%= link_to "Modifier", edit_recipe_path(@recipe), class: "btn-secondary btn-compact" %>
              <%= button_to "Supprimer", recipe_path(@recipe), method: :delete,
                  class: "btn-danger btn-compact",
                  data: { turbo_confirm: "Supprimer définitivement cette recette ?" } %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </article>

  <section class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]" aria-label="Préparation de la recette">
    <div class="app-card p-5 sm:p-6">
      <h2 class="da-section-title text-3xl font-black">Ingrédients</h2>
      <div class="ingredients mt-5">
        <%= render "recipes/ingredients_breakdown", recipe: @recipe %>
      </div>
    </div>

    <div class="app-card p-5 sm:p-6">
      <h2 class="da-section-title text-3xl font-black">Instructions</h2>
      <div class="instructions mt-5 space-y-4 text-sm leading-7 text-slate-700 dark:text-slate-300 sm:text-base">
        <%= simple_format @recipe.instructions %>
      </div>
    </div>
  </section>

  <section class="app-card p-5 sm:p-6" aria-labelledby="recipe-details-title">
    <h2 id="recipe-details-title" class="text-xl font-black">Repères pratiques</h2>
    <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="app-card-muted p-4">
        <dt class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Personnes</dt>
        <dd class="mt-1 text-2xl font-black"><%= @recipe.servings %></dd>
      </div>
      <div class="app-card-muted p-4">
        <dt class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Difficulté</dt>
        <dd class="mt-1 font-black"><%= @recipe.difficulty %></dd>
      </div>
      <div class="app-card-muted p-4">
        <dt class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Préparation</dt>
        <dd class="mt-1 text-xl font-black"><%= @recipe.preparation_time %> min</dd>
      </div>
      <div class="app-card-muted p-4">
        <dt class="text-xs font-black uppercase tracking-wide text-slate-500 dark:text-slate-400">Cuisson</dt>
        <dd class="mt-1 text-xl font-black"><%= @recipe.cooking_time %> min</dd>
      </div>
    </dl>

    <% if @recipe.seasonal_ingredients_used.any? %>
      <div class="mt-5 border-t border-slate-100 pt-5 dark:border-slate-800">
        <h3 class="text-sm font-black">Ingrédients de saison</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          <% @recipe.seasonal_ingredients_used.each do |ingredient| %>
            <span class="da-chip"><%= ingredient %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="space-y-5" aria-labelledby="reviews-title">
    <div>
      <p class="page-kicker">À table</p>
      <h2 id="reviews-title" class="da-section-title mt-1 text-4xl font-black">Avis</h2>
    </div>

    <% if user_signed_in? %>
      <% if @recipe.user == current_user %>
        <div class="app-card-muted p-5 text-sm font-bold text-slate-700 dark:text-slate-300">Vous êtes l’auteur de cette recette : les avis sont réservés aux autres cuisiniers.</div>
      <% elsif @current_user_review %>
        <div class="rounded-3xl border border-amber-200 bg-amber-50 p-5 text-sm font-bold text-amber-900 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-200">Votre avis est déjà publié ci-dessous.</div>
      <% else %>
        <div class="app-card p-5 sm:p-6">
          <h3 class="text-xl font-black">Partager mon expérience</h3>
          <p class="form-help">Votre retour aide à choisir les prochaines recettes.</p>
          <div class="mt-5"><%= render "reviews/form", recipe: @recipe, review: @review %></div>
        </div>
      <% end %>
    <% else %>
      <div class="app-card-muted p-5 text-center text-sm text-slate-600 dark:text-slate-300">
        <%= link_to "Connectez-vous", new_user_session_path, class: "auth-link" %> pour laisser un avis.
      </div>
    <% end %>

    <% if @reviews.any? %>
      <div class="grid gap-4">
        <%= render @reviews %>
      </div>
    <% else %>
      <div class="empty-state py-8">
        <p class="font-black">Aucun avis pour le moment</p>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Le premier retour apparaîtra ici.</p>
      </div>
    <% end %>
  </section>
</div>
