<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>OnMangeQuoi - Vos repas, simplement</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="Planifiez vos repas, utilisez votre stock et préparez une liste de courses claire.">
    <meta name="theme-color" content="#fff4df" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#11140f" media="(prefers-color-scheme: dark)">
    <meta name="application-name" content="OnMangeQuoi">
    <meta name="app-environment" content="<%= Rails.env %>">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="OnMangeQuoi">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script nonce="<%= content_security_policy_nonce %>">
      (function() {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="app-surface transition-colors duration-200">
    <%= link_to "Aller au contenu", "#main-content", class: "skip-link" %>

    <nav class="sticky top-0 z-40 border-b border-white/70 bg-white/85 shadow-sm backdrop-blur-xl dark:border-slate-800 dark:bg-slate-950/82" data-controller="theme" aria-label="Navigation principale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between gap-3">
          <div class="flex min-w-0 flex-1">
            <div class="flex min-w-0 flex-shrink-0 items-center">
              <%= link_to root_path, class: "min-w-0 rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--omq-tomato)]", aria: { label: "Retour à l'accueil OnMangeQuoi" } do %>
                <span class="brand-mark block truncate text-2xl font-black text-slate-950 dark:text-white sm:hidden">OMQ</span>
                <span class="brand-mark hidden truncate text-2xl font-black text-slate-950 dark:text-white sm:block">OnMangeQuoi</span>
                <span class="-mt-1 hidden text-xs font-black text-emerald-800 dark:text-emerald-300 sm:block">marché, menus, magie</span>
              <% end %>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-2 sm:gap-3">
            <button data-theme-target="toggle" data-action="click->theme#toggle" class="flex min-h-11 min-w-11 items-center justify-center rounded-2xl p-2.5 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--omq-tomato)] dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white" type="button" title="Activer le thème sombre" aria-label="Activer le thème sombre" aria-pressed="false">
              <svg data-theme-target="icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
              </svg>
            </button>

            <% if user_signed_in? %>
              <%= link_to new_plan_path, class: "hidden sm:inline-flex btn-primary", title: "Nouveau plan" do %>
                Nouveau plan
              <% end %>
              <%= link_to edit_profile_path, class: "hidden min-h-11 min-w-11 items-center justify-center rounded-2xl p-2.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white sm:inline-flex", title: "Mon profil", aria: { label: "Ouvrir mon profil" } do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              <% end %>
              <%= link_to pantry_items_path, class: "hidden min-h-11 min-w-11 items-center justify-center rounded-2xl p-2.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white sm:inline-flex", title: "Mon stock", aria: { label: "Ouvrir mon stock" } do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/>
                </svg>
              <% end %>
              <span class="hidden max-w-[14rem] truncate text-sm font-medium text-slate-600 dark:text-slate-300 md:inline"><%= current_user.email %></span>
              <%= button_to "Déconnexion", destroy_user_session_path,
                  method: :delete,
                  class: "hidden rounded-2xl bg-red-50 px-3 py-2 text-sm font-bold text-red-700 transition-colors hover:bg-red-100 dark:bg-red-950/40 dark:text-red-300 dark:hover:bg-red-950 sm:inline-flex" %>
            <% else %>
              <% if current_page?(new_user_registration_path) %>
                <%= link_to "Connexion", new_user_session_path,
                    class: "btn-secondary btn-compact" %>
              <% elsif current_page?(new_user_session_path) %>
                <%= link_to "Inscription", new_user_registration_path,
                    class: "btn-primary btn-compact" %>
              <% else %>
                <%= link_to "Connexion", new_user_session_path,
                    class: "hidden min-[390px]:inline-flex btn-secondary btn-compact" %>
                <%= link_to "Inscription", new_user_registration_path,
                    class: "btn-primary btn-compact" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <main id="main-content" class="app-container <%= 'app-container-with-mobile-nav' if user_signed_in? %>" tabindex="-1">
      <% if notice %>
        <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200" role="status" aria-live="polite">
          <%= notice %>
        </div>
      <% end %>

      <% if flash[:error] || flash[:alert] %>
        <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200" role="alert" aria-live="assertive">
          <%= flash[:error] || flash[:alert] %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <% if user_signed_in? %>
      <nav class="mobile-bottom-nav" aria-label="Navigation mobile">
        <%= link_to new_plan_path, class: mobile_nav_item_class(:plan), aria: { current: mobile_nav_aria_current(:plan) } do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Plan
        <% end %>
        <%= link_to pantry_items_path, class: mobile_nav_item_class(:stock), aria: { current: mobile_nav_aria_current(:stock) } do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          Stock
        <% end %>
        <%= link_to new_pantry_scan_path, class: mobile_nav_item_class(:scan), aria: { current: mobile_nav_aria_current(:scan) } do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Scan
        <% end %>
        <%= link_to edit_profile_path, class: mobile_nav_item_class(:profile), aria: { current: mobile_nav_aria_current(:profile) } do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A8.968 8.968 0 0112 15c2.21 0 4.232.8 5.879 2.129M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Profil
        <% end %>
      </nav>
    <% end %>
  </body>
</html>
