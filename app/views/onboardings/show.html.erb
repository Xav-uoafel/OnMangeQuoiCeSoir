<div class="max-w-2xl mx-auto py-12 px-4">
  <div class="text-center mb-10">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">Bienvenue sur OnMangeQuoiCeSoir !</h1>
    <p class="text-gray-600 dark:text-gray-400 mt-2">Configurons votre profil pour personnaliser vos recettes.</p>
  </div>

  <%= form_with(model: current_user, url: onboarding_path, method: :patch, class: "space-y-8") do |f| %>
    <div class="bg-white dark:bg-gray-800 shadow dark:shadow-gray-900/50 rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-4">1. Combien etes-vous a table ?</h2>
      <div>
        <%= f.label :household_size, "Nombre de personnes", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.number_field :household_size, min: 1, max: 20, value: current_user.household_size || 2,
            class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 shadow dark:shadow-gray-900/50 rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-4">2. Des restrictions alimentaires ?</h2>
      <div class="space-y-3">
        <% %w[vegetarien vegetalien sans_gluten sans_lactose halal casher].each do |restriction| %>
          <div class="flex items-center">
            <%= check_box_tag "user[dietary_restrictions][]", restriction,
                current_user.dietary_restrictions&.include?(restriction),
                id: "restriction_#{restriction}",
                class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 dark:border-gray-600 rounded" %>
            <%= label_tag "restriction_#{restriction}", restriction.humanize, class: "ml-2 text-sm text-gray-700 dark:text-gray-300" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-white dark:bg-gray-800 shadow dark:shadow-gray-900/50 rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-4">3. Des ingredients a eviter ?</h2>
      <div>
        <%= f.label :excluded_ingredients_text, "Ingredients exclus", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= text_field_tag "user[excluded_ingredients_text]",
            current_user.excluded_ingredients&.join(", "),
            class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500",
            placeholder: "Separes par des virgules (ex: fruits de mer, noix)" %>
      </div>

      <div class="mt-4">
        <%= f.label :preferred_max_prep_time, "Temps de preparation maximum (minutes)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= f.number_field :preferred_max_prep_time, min: 5, value: current_user.preferred_max_prep_time || 45,
            class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="flex justify-end">
      <%= f.submit "C'est parti !", class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700" %>
    </div>
  <% end %>
</div>
