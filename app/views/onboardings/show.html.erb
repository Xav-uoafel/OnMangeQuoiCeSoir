<div class="mx-auto max-w-2xl space-y-6">
  <div class="app-card p-5 text-center sm:p-8">
    <p class="page-kicker">Première configuration</p>
    <h1 class="page-title mt-2">Bienvenue sur OnMangeQuoi</h1>
    <p class="page-subtitle mx-auto">Trois réglages suffisent pour personnaliser vos prochaines recettes.</p>
  </div>

  <%= form_with(model: current_user, url: onboarding_path, method: :patch, class: "space-y-6") do |f| %>
    <% if current_user.errors.any? %>
      <div class="rounded-3xl border border-red-200 bg-red-50 p-5 text-red-900 dark:border-red-900 dark:bg-red-950/40 dark:text-red-100" role="alert">
        <h2 class="font-black">Vérifiez les informations saisies</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
          <% current_user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="app-card p-5 sm:p-6">
      <p class="page-kicker">Étape 1 sur 3</p>
      <h2 class="mt-1 text-xl font-black">Combien êtes-vous à table ?</h2>
      <div class="mt-5">
        <%= f.label :household_size, "Nombre de personnes", class: "form-label" %>
        <%= f.number_field :household_size, min: 1, max: 20, required: true,
            value: current_user.household_size || 2,
            inputmode: "numeric",
            class: "form-input mt-2" %>
      </div>
    </div>

    <fieldset class="app-card p-5 sm:p-6">
      <legend class="sr-only">Restrictions alimentaires</legend>
      <p class="page-kicker">Étape 2 sur 3</p>
      <h2 class="mt-1 text-xl font-black">Des restrictions alimentaires ?</h2>
      <p class="form-help">Laissez tout décoché si vous n’en avez pas.</p>

      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <% ApplicationHelper::DIETARY_RESTRICTION_LABELS.each do |restriction, label| %>
          <label class="choice-card">
            <%= check_box_tag "user[dietary_restrictions][]", restriction,
                current_user.dietary_restrictions&.include?(restriction),
                id: "restriction_#{restriction}" %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="app-card p-5 sm:p-6">
      <p class="page-kicker">Étape 3 sur 3</p>
      <h2 class="mt-1 text-xl font-black">Vos préférences pratiques</h2>

      <div class="mt-5 space-y-5">
        <div>
          <%= f.label :excluded_ingredients_text, "Ingrédients à éviter", class: "form-label" %>
          <%= text_field_tag "user[excluded_ingredients_text]",
              current_user.excluded_ingredients&.join(", "),
              class: "form-input mt-2",
              aria: { describedby: "onboarding-excluded-help" },
              placeholder: "Ex. fruits de mer, noix" %>
          <p id="onboarding-excluded-help" class="form-help">Séparez les ingrédients par des virgules.</p>
        </div>

        <div>
          <%= f.label :preferred_max_prep_time, "Préparation maximum (minutes)", class: "form-label" %>
          <%= f.number_field :preferred_max_prep_time, min: 5, max: 1440, required: true,
              value: current_user.preferred_max_prep_time || 45,
              inputmode: "numeric",
              class: "form-input mt-2" %>
        </div>
      </div>
    </div>

    <div class="mobile-sticky-actions" aria-label="Terminer la configuration">
      <div class="mx-auto max-w-2xl">
        <%= f.submit "Enregistrer et commencer", class: "btn-primary w-full cursor-pointer",
            data: { turbo_submits_with: "Enregistrement…" } %>
      </div>
    </div>
  <% end %>
</div>
