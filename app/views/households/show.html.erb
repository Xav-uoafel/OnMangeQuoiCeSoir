<div class="max-w-2xl mx-auto py-8 px-4">
  <h1 class="text-3xl font-bold mb-6">Mon foyer</h1>

  <div class="bg-white dark:bg-gray-800 shadow dark:shadow-gray-900/50 rounded-lg p-6 mb-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-semibold"><%= @household.name %></h2>
      <% if current_user.household_admin? %>
        <%= link_to "Modifier", edit_household_path,
            class: "text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-800" %>
      <% end %>
    </div>

    <div class="bg-indigo-50 dark:bg-indigo-900/20 rounded-lg p-4 mb-6">
      <p class="text-sm text-indigo-700 dark:text-indigo-400 font-medium">Code d'invitation</p>
      <p class="text-2xl font-mono font-bold text-indigo-900 mt-1"><%=  @household.invite_code %></p>
      <p class="text-xs text-indigo-600 dark:text-indigo-400 mt-1">Partagez ce code pour inviter des membres a votre foyer.</p>
    </div>

    <h3 class="font-semibold text-gray-700 dark:text-gray-300 mb-3">Membres (<%= @members.size %>)</h3>
    <ul class="divide-y divide-gray-200 dark:divide-gray-700">
      <% @members.each do |member| %>
        <li class="py-3 flex justify-between items-center">
          <div>
            <span class="font-medium"><%= member.email %></span>
            <% if member.household_admin? %>
              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-800">Admin</span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <%= link_to "Retour", authenticated_root_path,
      class: "inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-600 text-sm font-medium rounded-md text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700" %>
</div>
